{
  "specVersion": "1.0",
  "slug": "reading-time",
  "name": "阅读时间",
  "version": "1.0.2",
  "description": "文章阅读时间 + 字数统计，onRenderMarkdown 扩展点实现",
  "author": "RainyNest Team",
  "entry": "index.ts",
  "permissions": [
    {
      "name": "plugin:reading-time:view",
      "displayName": "查看阅读时间",
      "group": "插件"
    }
  ],
  "configSchema": {
    "basic": {
      "label": "基础设置",
      "fields": {
        "wpm": {
          "type": "number",
          "default": 300,
          "min": 100,
          "max": 600,
          "label": "每分钟阅读字数"
        },
        "showWords": {
          "type": "boolean",
          "default": true,
          "label": "显示字数统计"
        }
      }
    }
  }
}
