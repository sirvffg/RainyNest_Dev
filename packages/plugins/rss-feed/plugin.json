{
  "specVersion": "1.0",
  "slug": "rss-feed",
  "name": "RSS 订阅",
  "version": "1.0.1",
  "description": "RSS 2.0 / Atom 双格式订阅源，自动输出最近 20 篇已发布文章",
  "author": "RainyNest Team",
  "entry": "index.ts",
  "permissions": [
    {
      "name": "plugin:rss-feed:view",
      "displayName": "查看 RSS 订阅",
      "group": "插件"
    }
  ],
  "configSchema": {
    "basic": {
      "label": "订阅设置",
      "fields": {
        "limit": {
          "type": "number",
          "default": 20,
          "min": 1,
          "max": 100,
          "label": "输出文章数"
        }
      }
    }
  }
}
