// RainyNest 主库 Schema（blog.db）
// 用户/RBAC/文章/评论/分类/标签/页面/说说/相册/友链/菜单/主题/插件/站点设置

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// 用户与权限（RBAC 2.0，仿 Halo）
// ═══════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  displayName   String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  phone         String?
  phoneVerified DateTime?
  avatar        String?
  bio           String?
  description   String?

  status         String    @default("ENABLED") // ENABLED | DISABLED | LOCKED
  loginFailCount Int       @default(0)
  lockedUntil    DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  lastLoginIp String?

  posts      Post[]
  comments   Comment[]
  moments    Moment[]
  roles      UserRole[]
  identities Identity[]
  sessions   Session[]

  @@index([username])
  @@index([email])
}

model Role {
  id            String  @id @default(cuid())
  name          String  @unique
  displayName   String
  description   String?
  builtIn       Boolean @default(false)
  forbidConsole Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          UserRole[]
  permissions    RolePermission[]
  roleTemplateId String?
  roleTemplate   RoleTemplate?    @relation(fields: [roleTemplateId], references: [id])
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  group       String
  description String?

  roles         RolePermission[]
  roleTemplates RoleTemplatePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RoleTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  description String?
  pluginSlug  String
  dependsOn   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles       Role[]
  permissions RoleTemplatePermission[]
}

model RoleTemplatePermission {
  roleTemplateId String
  permissionId   String
  roleTemplate   RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleTemplateId, permissionId])
}

model Identity {
  id         String    @id @default(cuid())
  userId     String
  provider   String // PASSWORD | EMAIL_CODE | PHONE_CODE | OAUTH2_GITHUB | OAUTH2_GOOGLE | OAUTH2_WECHAT | LDAP
  identifier String
  credential String?
  authUrl    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, identifier])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  userAgent    String?
  ip           String?
  device       String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ═══════════════════════════════════════════════════════════
// 内容：文章 / 分类 / 标签 / 评论 / 页面 / 说说 / 相册 / 友链 / 菜单
// ═══════════════════════════════════════════════════════════

model Post {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  title      String
  slug       String  @unique
  summary    String?
  content    String
  html       String?
  coverImage String?

  status       String  @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  isTop        Boolean @default(false)
  allowComment Boolean @default(true)

  views Int @default(0)
  words Int @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  tags     PostTag[]
  comments Comment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status, publishedAt])
  @@index([slug])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  posts       Post[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  summary   String?
  status    String   @default("PUBLISHED")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Moment {
  id        String   @id @default(cuid())
  userId    String
  content   String
  images    String?
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  photos      Photo[]
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Photo {
  id        String   @id @default(cuid())
  galleryId String
  url       String
  title     String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
}

model Link {
  id          String   @id @default(cuid())
  name        String
  url         String
  logo        String?
  description String?
  category    String?
  order       Int      @default(0)
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
}

model Menu {
  id        String   @id @default(cuid())
  name      String
  url       String
  icon      String?
  order     Int      @default(0)
  parentId  String?
  parent    Menu?    @relation("MenuChildren", fields: [parentId], references: [id])
  children  Menu[]   @relation("MenuChildren")
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════
// 主题 / 插件 / 站点设置
// ═══════════════════════════════════════════════════════════

model Theme {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  version     String
  description String?
  author      String?
  preview     String?
  isActive    Boolean  @default(false)
  config      String?
  source      String   @default("builtin") // builtin=内置预装 uploaded=后台上传
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plugin {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  version     String
  description String?
  author      String?
  isActive    Boolean  @default(false)
  config      String?
  source      String   @default("builtin") // builtin=内置预装 uploaded=后台上传
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id String @id @default("default")

  title       String  @default("RainyNest")
  subtitle    String?
  description String  @default("一个关于技术与生活的博客")
  url         String  @default("http://localhost:3000")
  logo        String?
  favicon     String?
  icp         String?
  footerText  String?

  keywords           String?
  author             String?
  googleVerification String?
  baiduVerification  String?

  githubUrl  String?
  twitterUrl String?
  email      String?

  allowRegister     Boolean @default(false)
  commentModeration Boolean @default(true)
  enableRss         Boolean @default(true)
  enableSitemap     Boolean @default(true)

  // Markdown 渲染开关
  codeShowLineNumbers   Boolean @default(true)
  codeCollapsible       Boolean @default(true)
  codeCollapseThreshold Int     @default(15)
  codeLanguageBadge     Boolean @default(true)
  enableCallouts        Boolean @default(true)
  enableMath            Boolean @default(true)
  enableWikiLink        Boolean @default(false)
  enableReadingTime     Boolean @default(true)
  enableEmailProtection Boolean @default(true)

  // SMTP
  smtpHost String?
  smtpPort Int?
  smtpUser String?
  smtpPass String?
  smtpFrom String?

  primaryColor String? @default("#3b82f6")

  // 访客 IP 获取方式（auto=自动按优先级读代理头；direct=不读任何头，记 127.0.0.1；
  // custom=读取 ipCustomHeader 指定的自定义头）
  ipSource       String  @default("auto")
  ipCustomHeader String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
